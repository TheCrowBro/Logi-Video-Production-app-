{
  "name": "vdex",
  "productName": "Vdex",
  "version": "1.2.0",
  "description": "Production deck for freelance videographers: bookings, crew, kit, venues, insurance, a shoot-day clock, timecode notes and field tools.",
  "private": true,
  "main": "desktop/main.js",
  "homepage": "https://github.com/TheCrowBro/Logi-Video-Production-app-",
  "author": "TheCrowBro",
  "scripts": {
    "start": "node desktop/sync-version.js && electron .",
    "dist": "node desktop/sync-version.js && electron-builder --publish never",
    "stamp": "node tools/stamp-build.mjs",
    "test": "node tests/run.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "app.vdex.desktop",
    "productName": "Vdex",
    "copyright": "TheCrowBro",
    "directories": {
      "buildResources": "desktop/build",
      "output": "dist"
    },
    "files": [
      "index.html",
      "privacy.html",
      "invoice.html",
      "styles.css",
      "sw.js",
      "manifest.webmanifest",
      "icons/**",
      "js/**",
      "vendor/**",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/updater.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Vdex-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vdex",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "Vdex-${version}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Vdex uses the camera to scan timecode, read white balance and scan link codes.",
        "NSMicrophoneUsageDescription": "Vdex uses the microphone for the noise meter.",
        "NSLocationWhenInUseUsageDescription": "Vdex uses your location for sunrise, sunset and Polaris."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "desktop/build/entitlements.mac.plist",
      "notarize": false
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "Vdex-${version}.${ext}",
      "synopsis": "Production deck for videographers"
    },
    "publish": {
      "provider": "github",
      "owner": "TheCrowBro",
      "repo": "Logi-Video-Production-app-"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
