// The website at https://vdex.crowmade.app: a Cloudflare Worker that only serves static files (no script runs).
// The custom domain is attached once in the Cloudflare dashboard, so there are no "routes" here (a deploy would
// otherwise replace the dashboard's). The files come from cloudflare/site, built by tools/stage-cloudflare.mjs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vdex",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
