// The website at https://vdex.crowmade.app: a Cloudflare Worker that only serves static files (no script runs).
// The address is a Custom Domain: on the first publish Cloudflare creates its DNS record and certificate by itself,
// in the crowmade.app zone, touching nothing else there. The files come from cloudflare/site, built by
// tools/stage-site.mjs. html_handling "none" serves /index.html, /invoice.html and the rest by their own names (the
// offline copy and every shared link use them) instead of redirecting them.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vdex",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "vdex.crowmade.app", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
